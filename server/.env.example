# AreYouOK Server

# Base URL of the deployed app (used for invite links + Stripe redirects)
PUBLIC_BASE_URL=http://localhost:8080

# Stripe (required for subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICE_ID_MONTHLY=
PRICE_ID_YEARLY=

# Web Push (optional)
# Generate keys:
#   node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@your-domain.com

# Email / OTP (required in production)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
# true for SMTPS / port 465, otherwise false
SMTP_SECURE=false
# Optional: force STARTTLS when your provider requires it
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AreYouOK <no-reply@your-domain.com>"
# Optional
SMTP_REPLY_TO=

# Development only: if SMTP is missing, allow returning the OTP in the API response.
# Keep this OFF in production.
ALLOW_DEV_OTP_FALLBACK=0

# DB path (optional)
DB_PATH=./data/ayok.db

# Security
JWT_SECRET=change-me
